# Mudrex API Secret (required) - legacy single account
MUDREX_API_SECRET=your_mudrex_api_secret_here

# Multi-account: up to 10 API secrets (Secret_1 = yours, 2..10 = friends). Same strategy per account.
# If any MUDREX_API_SECRET_N is set, multi-account mode is used; otherwise legacy MUDREX_API_SECRET is used.
# MUDREX_API_SECRET_1=your_secret
# MUDREX_API_SECRET_2=friend_2_secret
# MUDREX_API_SECRET_3=friend_3_secret

# Margin as % of futures wallet used per position (required - set in Railway)
# e.g. 50 = 50% of available balance
MARGIN_PERCENTAGE=50

# Telegram: one bot token for all. Chat IDs per account so each user gets notifications about their account.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Legacy single-account: TELEGRAM_CHAT_ID (comma-separated)
TELEGRAM_CHAT_ID=your_telegram_chat_id
# Multi-account: TELEGRAM_CHAT_ID_1, _2, ... _10 (comma-separated per account for multiple devices/chats)
# TELEGRAM_CHAT_ID_1=123,456
# TELEGRAM_CHAT_ID_2=789
# TELEGRAM_CHAT_ID_3=111,222

# Optional
DRY_RUN=false
LOG_LEVEL=INFO
